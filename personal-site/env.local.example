# PostgreSQL Database Connection
# The connection logic in `src/lib/db.ts` uses a connection string.
# For production environments (like Vercel), set this environment variable.
# For local development, you can create a `.env.local` file and place this variable in it.

POSTGRES_URL="postgresql://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_DATABASE_HOST:5432/YOUR_DATABASE_NAME"
